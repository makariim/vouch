{
  "manifest_version": 3,
  "name": "Vouch — evidence audit",
  "version": "0.2.0",
  "description": "Tells you quietly when you are on a job post, and whether it is worth your evening.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/panel.html",
    "default_title": "Vouch",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/detect.js"],
      "run_at": "document_idle"
    }
  ]
}
